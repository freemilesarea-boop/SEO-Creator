{
  "name": "seo-creator",
  "version": "1.0.0",
  "description": "YouTube 플레이리스트 SEO 최적화 제목 · 썸네일 생성기",
  "author": "SEO Creator",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:backend": "cd backend && python3 -m uvicorn app.main:app --host 127.0.0.1 --port 18484 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "sleep 5 && ELECTRON_DEV=true electron .",
    "build:frontend": "cd frontend && npm run build",
    "build:app": "npm run build:frontend && electron-builder",
    "build:mac": "npm run build:frontend && electron-builder --mac",
    "build:win": "npm run build:frontend && electron-builder --win",
    "postinstall": "cd frontend && npm install"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.seocreator.app",
    "productName": "SEO Creator",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**/*",
      "frontend/out/**/*",
      "backend/**/*",
      "!backend/**/__pycache__/**",
      "!backend/**/*.pyc",
      "!**/.next/**",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend-bundle/backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "darkModeSupport": true
    },
    "dmg": {
      "title": "SEO Creator",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerHeaderIcon": "assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    }
  }
}
