{
  "name": "seo-creator",
  "version": "2.0.0",
  "description": "YouTube 플레이리스트 SEO 최적화 제목 · 썸네일 생성기",
  "author": "SEO Creator",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "sleep 3 && electron .",
    "build:frontend": "cd frontend && npm run build",
    "build:app": "npm run build:frontend && electron-builder",
    "build:mac": "npm run build:frontend && electron-builder --mac",
    "build:win": "npm run build:frontend && electron-builder --win",
    "check:dict": "node scripts/check-dictionary.js",
    "postinstall": "cd frontend && npm install --prefer-offline --no-audit"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.seocreator.app",
    "productName": "SEO Creator",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**/*",
      "engine/**/*",
      "build/**/*",
      "backend/app/data/**/*.json",
      "frontend/out/**/*",
      "!**/.next/**",
      "!frontend/node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": null,
      "notarize": false,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
