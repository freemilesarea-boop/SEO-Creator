{
  "name": "seo-creator",
  "version": "2.1.0",
  "description": "YouTube 플레이리스트 SEO 최적화 제목 · 썸네일 생성기",
  "author": "SEO Creator",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "wait-on http://localhost:3000 && cross-env ELECTRON_DEV=true electron .",
    "build:frontend": "cd frontend && npm run build",
    "build:app": "npm run build:frontend && electron-builder",
    "build:mac": "npm run build:frontend && electron-builder --mac",
    "build:win": "npm run build:frontend && electron-builder --win",
    "build:linux": "npm run build:frontend && electron-builder --linux",
    "test:engine": "node scripts/test-engine.js",
    "postinstall": "cd frontend && npm install --prefer-offline --no-audit"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.seocreator.app",
    "productName": "SEO Creator",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**/*",
      "engine/**/*",
      "engine/data/**/*.json",
      "build/**/*",
      "frontend/out/**/*",
      "!**/.next/**",
      "!frontend/node_modules/**",
      "!frontend/src/**",
      "!**/__pycache__/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "title": "SEO Creator",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
