# YouTube Data API Key (required for playlist link parsing)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Unsplash API Key (optional, for thumbnail image suggestions)
UNSPLASH_API_KEY=your_unsplash_api_key_here

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database
DATABASE_URL=sqlite:///./seo_creator.db
