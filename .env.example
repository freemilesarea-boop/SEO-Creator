# YouTube Data API Key (required for playlist link parsing)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Unsplash API Key (optional, for thumbnail image suggestions)
UNSPLASH_API_KEY=your_unsplash_api_key_here

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database
DATABASE_URL=sqlite:///./seo_creator.db

# Google Trends (optional)
# off = 내부 사전만 사용 (기본값, 추가 설정 불필요)
# mock = 내장 트렌드 데이터 사용 (테스트/데모용)
# bigquery = Google Trends BigQuery dataset 연동
GOOGLE_TRENDS_MODE=off
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
TRENDS_CACHE_TTL_HOURS=24
TRENDS_REGION=KR
TRENDS_LANGUAGE=ko
